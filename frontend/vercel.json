{
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "https://friday-backend-liard.vercel.app/admin/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://friday-backend-liard.vercel.app/auth/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
